---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { index, eyebrow, title, intro } = Astro.props;
---

<div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
  <div>
    <p class="mb-3 font-mono text-xs tracking-[0.24em] text-ash uppercase">{index} — {eyebrow}</p>
    <h2 class="font-mono text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
  </div>
  {intro && <p class="max-w-md text-ink/70 dark:text-bone/70">{intro}</p>}
</div>
