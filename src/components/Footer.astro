---
import Wordmark from './Wordmark.astro';
import { NAV, SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 dark:border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Wordmark class="h-[39px]" />
      <p class="mt-5 max-w-xs text-sm text-ink/60 dark:text-bone/60">{SITE.tagline} A one-person software lab.</p>
    </div>
    <div>
      <p class="mb-4 font-mono text-xs tracking-[0.2em] text-ash uppercase">Site</p>
      <ul class="space-y-2 text-sm">
        {NAV.map((item) => <li><a href={item.href} class="hover:text-flame-deep dark:hover:text-flame">{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="mb-4 font-mono text-xs tracking-[0.2em] text-ash uppercase">Elsewhere</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/brand" class="hover:text-flame-deep dark:hover:text-flame">Brand</a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener" class="hover:text-flame-deep dark:hover:text-flame">GitHub ↗</a></li>
        <li><a href="https://kinglet.rushlightlab.com/" target="_blank" rel="noopener" class="hover:text-flame-deep dark:hover:text-flame">Kinglet ↗</a></li>
        <li><a href={`mailto:${SITE.email}`} class="hover:text-flame-deep dark:hover:text-flame">{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink/10 dark:border-line">
    <p class="mx-auto max-w-6xl px-4 py-6 font-mono text-xs tracking-[0.2em] text-ash uppercase sm:px-6">© {year} {SITE.name}</p>
  </div>
</footer>
